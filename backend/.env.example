# Copie para ".env" e ajuste. NUNCA envie o arquivo .env real para o GitHub ou em ZIPs.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/crm_enterprise?schema=public"
# Segredo do JWT: use um valor longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_EXPIRES_IN="7d"
# Chave que criptografa a senha SMTP no banco (se vazia, usa o JWT_SECRET). Trocar a chave invalida senhas já salvas.
SMTP_ENCRYPTION_KEY=""
PORT=3001
NODE_ENV=development
# Remetente padrão sugerido (opcional)
DEFAULT_FROM_EMAIL=""
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
